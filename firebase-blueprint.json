{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user profile, personal identity, and two-level family kinship marga & name data for Simalungun Partuturan calculation.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the profile owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name or nickname of the user.",
          "minLength": 1,
          "maxLength": 100
        },
        "myGender": {
          "type": "string",
          "description": "Biological/customary gender role in Simalungun kinship.",
          "enum": ["Laki-laki", "Perempuan"],
          "minLength": 1,
          "maxLength": 20
        },
        "myMarga": {
          "type": "string",
          "description": "User's own marga or boru (supports Simalungun, Toba, Karo, or plain text).",
          "minLength": 1,
          "maxLength": 100
        },
        "myFatherName": {
          "type": "string",
          "description": "Name of the user's father (Bapa).",
          "minLength": 0,
          "maxLength": 100
        },
        "myMotherName": {
          "type": "string",
          "description": "Name of the user's mother (Inang).",
          "minLength": 0,
          "maxLength": 100
        },
        "myMotherMarga": {
          "type": "string",
          "description": "Boru/marga of the user's mother (Marga Tulang).",
          "minLength": 1,
          "maxLength": 100
        },
        "mySpouseName": {
          "type": "string",
          "description": "Name of the user's spouse or partner.",
          "minLength": 0,
          "maxLength": 100
        },
        "mySpouseMarga": {
          "type": "string",
          "description": "Marga/boru of the user's spouse or partner.",
          "minLength": 0,
          "maxLength": 100
        },
        "mySpouseFatherName": {
          "type": "string",
          "description": "Name of the spouse's father (Tulang / Makkela Simatua).",
          "minLength": 0,
          "maxLength": 100
        },
        "mySpouseMotherName": {
          "type": "string",
          "description": "Name of the spouse's mother (Anturang / Amboru Simatua).",
          "minLength": 0,
          "maxLength": 100
        },
        "mySpouseMotherMarga": {
          "type": "string",
          "description": "Boru of the spouse's mother (Tondong ni Tondong).",
          "minLength": 0,
          "maxLength": 100
        },
        "mySpouseOmpungMarga": {
          "type": "string",
          "description": "Boru of the spouse's grandmother (Ompung Istri).",
          "minLength": 0,
          "maxLength": 100
        },
        "myFatherMotherMarga": {
          "type": "string",
          "description": "Boru of the user's paternal grandmother (Ompung dari Bapak).",
          "minLength": 0,
          "maxLength": 100
        },
        "myMotherMotherMarga": {
          "type": "string",
          "description": "Boru of the user's maternal grandmother (Ompung dari Ibu).",
          "minLength": 0,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": [
        "uid",
        "displayName",
        "myGender",
        "myMarga",
        "myFatherName",
        "myMotherName",
        "myMotherMarga",
        "mySpouseName",
        "mySpouseMarga",
        "mySpouseFatherName",
        "mySpouseMotherName",
        "mySpouseMotherMarga",
        "mySpouseOmpungMarga",
        "myFatherMotherMarga",
        "myMotherMotherMarga",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomLexiconEntry": {
      "title": "CustomLexiconEntry",
      "description": "User-saved custom Simalungun-Indonesian dictionary entry.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the user who created this dictionary entry.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "simalungun": {
          "type": "string",
          "description": "Simalungun word or phrase.",
          "minLength": 1,
          "maxLength": 200
        },
        "indonesian": {
          "type": "string",
          "description": "Indonesian meaning.",
          "minLength": 1,
          "maxLength": 300
        },
        "partOfSpeech": {
          "type": "string",
          "description": "Grammatical part of speech.",
          "minLength": 1,
          "maxLength": 30
        },
        "category": {
          "type": "string",
          "description": "Lexicon category.",
          "minLength": 1,
          "maxLength": 60
        },
        "exampleSimalungun": {
          "type": "string",
          "description": "Example sentence in Simalungun.",
          "minLength": 0,
          "maxLength": 400
        },
        "exampleIndonesian": {
          "type": "string",
          "description": "Example sentence meaning in Indonesian.",
          "minLength": 0,
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "ownerId",
        "simalungun",
        "indonesian",
        "partOfSpeech",
        "category",
        "exampleSimalungun",
        "exampleIndonesian",
        "createdAt",
        "updatedAt"
      ]
    },
    "SavedTranslation": {
      "title": "SavedTranslation",
      "description": "User-cached translation item persisted across sessions.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the user who owns this cached translation.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sourceText": {
          "type": "string",
          "description": "Original input text.",
          "minLength": 1,
          "maxLength": 1000
        },
        "translatedText": {
          "type": "string",
          "description": "Translated output text.",
          "minLength": 1,
          "maxLength": 1000
        },
        "direction": {
          "type": "string",
          "description": "Translation direction.",
          "minLength": 1,
          "maxLength": 30
        },
        "style": {
          "type": "string",
          "description": "Speech register style.",
          "minLength": 1,
          "maxLength": 30
        },
        "phoneticGuide": {
          "type": "string",
          "description": "Phonetic pronunciation guide.",
          "minLength": 0,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "ownerId",
        "sourceText",
        "translatedText",
        "direction",
        "style",
        "phoneticGuide",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores each authenticated user's personal profile and family tree margas/names."
    },
    "/users/{userId}/lexicon/{entryId}": {
      "schema": {
        "$ref": "#/entities/CustomLexiconEntry"
      },
      "description": "Stores custom dictionary entries saved by a specific user."
    },
    "/users/{userId}/translations/{cacheId}": {
      "schema": {
        "$ref": "#/entities/SavedTranslation"
      },
      "description": "Stores cached translations and saved sentences for a specific user."
    }
  }
}
